# SpaceSweepers settings. Copy this file to .env to change one. Every line is optional: the value shown is the default.
# There are no secrets in this app: it has no accounts, keys or tokens. .env is git-ignored only so local choices stay local.

# The one SI model the app uses (IBM Granite 3.3 2B, Apache-2.0). Pull it with: ollama pull granite3.3:2b
SS_SI_MODEL=granite3.3:2b

# Where Ollama listens. Keep it on this computer.
SS_OLLAMA_URL=http://127.0.0.1:11434

# Host names the app answers to. Add your domain when you deploy (a JSON list).
SS_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Rate limits per visitor.
SS_API_RATE_LIMIT=120/minute
SS_ASK_RATE_LIMIT=10/minute

# SI Insights: how long a question may wait for the one model, and how many may wait at once.
SS_SI_QUEUE_WAIT_SECONDS=90
SS_SI_MAX_WAITING=4

# Where the PSI snapshot is read from, and where run logs and downloads are kept (a git-ignored folder).
# SS_DATA_DIR=data
# SS_CACHE_DIR=.cache
